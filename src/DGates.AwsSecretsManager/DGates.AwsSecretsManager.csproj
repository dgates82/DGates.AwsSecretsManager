<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DGates.AwsSecretsManager</RootNamespace>
    <AssemblyName>DGates.AwsSecretsManager</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet packaging metadata -->
    <PackageId>DGates.AwsSecretsManager</PackageId>
    <Version>0.1.0</Version>
    <Authors>YOUR_NAME</Authors>
    <Description>Typed, cached, retry-aware wrapper around AWS Secrets Manager for .NET Framework 4.8.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/YOUR_GITHUB_USERNAME/DGates.AwsSecretsManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YOUR_GITHUB_USERNAME/DGates.AwsSecretsManager</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aws;secretsmanager;dotnet;netframework;configuration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
    <PackageReference Include="Polly" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
