# Exclude .NET build artifacts and binaries
**/bin/
**/obj/

# Exclude IDE/User-specific settings and cache
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Exclude heavy diagnostics and test output logs
*.log
**/TestResults/
*.trx
*.vstest/

# Exclude local Claude config overrides
.claude/settings.local.json
CLAUDE.local.md

# Prevent reading packages/caches
**/packages/
.nuget/

